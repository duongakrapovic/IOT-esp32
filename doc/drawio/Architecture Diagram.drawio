        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n    %% =========================\n    %% HARDWARE\n    %% =========================\n\n    subgraph HW[\&quot;THIẾT BỊ / HARDWARE\&quot;]\n\n        DHT[\&quot;DHT11&lt;br/&gt;Nhiệt độ + Độ ẩm\&quot;]\n\n        LIGHT[\&quot;Cảm biến ánh sáng&lt;br/&gt;Cường độ ánh sáng\&quot;]\n\n        ESP[\&quot;ESP32&lt;br/&gt;Bộ điều khiển trung tâm\&quot;]\n\n        LED[\&quot;3 × LED&lt;br/&gt;Thiết bị thực thi\&quot;]\n\n        DHT --&gt;|Đọc dữ liệu| ESP\n        LIGHT --&gt;|Đọc dữ liệu| ESP\n        ESP --&gt;|Điều khiển GPIO| LED\n\n    end\n\n\n    %% =========================\n    %% NETWORK\n    %% =========================\n\n    subgraph NET[\&quot;TẦNG MẠNG\&quot;]\n\n        MQTT[\&quot;MQTT Broker&lt;br/&gt;Eclipse Mosquitto&lt;br/&gt;Local :1883\&quot;]\n\n        TOPICS[\&quot;MQTT Topics&lt;br/&gt;&lt;br/&gt;iot/sensors/data&lt;br/&gt;iot/devices/command&lt;br/&gt;iot/devices/status\&quot;]\n\n        MQTT --- TOPICS\n\n    end\n\n\n    %% =========================\n    %% APPLICATION\n    %% =========================\n\n    subgraph APP[\&quot;TẦNG ỨNG DỤNG\&quot;]\n\n        BACKEND[\&quot;Backend&lt;br/&gt;Node.js + Express&lt;br/&gt;mqtt + socket.io\&quot;]\n\n        DB[(\&quot;MySQL Database&lt;br/&gt;&lt;br/&gt;Sensor&lt;br/&gt;Data Sensor&lt;br/&gt;Devices&lt;br/&gt;Active_history&lt;br/&gt;Profile\&quot;)]\n\n        WEB[\&quot;Frontend Web&lt;br/&gt;HTML + CSS + JavaScript&lt;br/&gt;Chart.js\&quot;]\n\n        PAGES[\&quot;Các chức năng Web&lt;br/&gt;&lt;br/&gt;Dashboard&lt;br/&gt;Data Sensor&lt;br/&gt;Active History&lt;br/&gt;Profile\&quot;]\n\n        SOCKET[\&quot;Socket.IO&lt;br/&gt;Truyền / cập nhật dữ liệu giữa Backend và Web&lt;br/&gt;&lt;br/&gt;Yêu cầu cập nhật dữ liệu: 2 giây/lần\&quot;]\n\n        WEB --- PAGES\n        BACKEND --- SOCKET\n\n    end\n\n\n    %% =========================\n    %% COMMUNICATION\n    %% =========================\n\n    ESP --&gt;|Wi-Fi + MQTT&lt;br/&gt;Dữ liệu cảm biến| MQTT\n\n    MQTT --&gt;|MQTT command / status| ESP\n\n    MQTT --&gt;|MQTT Publish / Subscribe| BACKEND\n\n    BACKEND --&gt;|Query / Insert| DB\n\n    BACKEND --&gt;|HTTP API + Socket.IO| WEB&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2jeyiC8SHEy6DjJ-7H27-1">
